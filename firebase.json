{
  "functions": [{ "source": "functions", "codebase": "souq" }],
  "firestore": { "rules": "firestore.rules" },
  "storage": { "rules": "storage.rules" },
  "auth": { "providers": { "emailPassword": true, "googleSignIn": { "oAuthBrandDisplayName": "سوق", "supportEmail": "support@bonyanx.net" } } },
  "emulators": {
    "firestore": { "host": "127.0.0.1", "port": 8099 },
    "functions": { "host": "127.0.0.1", "port": 5002 },
    "ui": { "enabled": true, "port": 4002 }
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["node scripts/check-online-env.mjs", "node node_modules/vite/bin/vite.js build"],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "me-central1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
